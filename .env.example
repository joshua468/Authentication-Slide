# Database
# PostgreSQL connection string. Template only - replace host, port, user,
# password and database with your own PostgreSQL instance, and create the
# database before running the migration:
DATABASE_URL="postgresql://postgres:your_password@127.0.0.1:5432/authentication?schema=public"

# Auth
# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# AUTH_SECRET=""

# Email (optional)
# Leave unset to log emails to the console in dev. To send real mail, uncomment and fill in:
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""
# EMAIL_FROM="you@example.com"